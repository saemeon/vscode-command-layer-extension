        "commandLayer.eventActions": {
          "type": "array",
          "default": [],
          "description": "The only actions that run without you initiating them. Every firing is logged to the Command Layer output channel.",
          "items": {
            "type": "object",
            "required": [
              "on"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "Label shown in pickers, CodeLens, hovers and menus."
              },
