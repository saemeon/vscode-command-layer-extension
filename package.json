{
  "name": "command-layer",
  "displayName": "Command Layer",
  "description": "A pluggable command layer for VS Code: trigger any command from anywhere — matched text, selections, files, terminal output, status bar — configured entirely in settings.",
  "icon": "icon.png",
  "version": "0.1.1",
  "publisher": "saemeon",
  "author": {
    "name": "Simon Niederberger"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/saemeon/vscode-command-layer-extension.git"
  },
  "bugs": {
    "url": "https://github.com/saemeon/vscode-command-layer-extension/issues"
  },
  "homepage": "https://github.com/saemeon/vscode-command-layer-extension#readme",
  "keywords": [
    "commands",
    "launcher",
    "automation",
    "settings",
    "context menu",
    "status bar"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "commandLayer.runAllActions",
        "title": "Command Layer: All Actions..."
      },
      {
        "command": "commandLayer.runTextActions",
        "title": "Command Layer: Text Actions..."
      },
      {
        "command": "commandLayer.runFileActions",
        "title": "Command Layer: File Actions..."
      },
      {
        "command": "commandLayer.runSelectionActions",
        "title": "Command Layer: Selection Actions..."
      },
      {
        "command": "commandLayer.runGlobalActions",
        "title": "Command Layer: Global Actions..."
      },
      {
        "command": "commandLayer.openExternal",
        "title": "Open Externally",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.copyToClipboard",
        "title": "Copy To Clipboard",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.copyCommandId",
        "title": "Copy Command Id"
      },
      {
        "command": "commandLayer.copyActionStub",
        "title": "Copy Action Stub"
      },
      {
        "command": "commandLayer.refreshViews",
        "title": "Refresh Views",
        "icon": "$(refresh)",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.util.searchSelection",
        "title": "Search Selection Ignoring Whitespace (util)",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.util.searchSelectionExact",
        "title": "Search Selection Exactly (util)",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.util.writeFile",
        "title": "Write File (util)",
        "category": "Command Layer"
      },
      {
        "command": "commandLayer.runEditorTitleAction",
        "title": "Run Editor Title Action",
        "category": "Command Layer",
        "icon": "$(zap)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "commandLayer.runAllActions",
          "when": "editorTextFocus",
          "group": "navigation@1"
        },
        {
          "command": "commandLayer.runTextActions",
          "when": "editorTextFocus && commandLayer.hasMatch",
          "group": "commandLayer@1"
        },
        {
          "command": "commandLayer.runSelectionActions",
          "when": "editorTextFocus && editorHasSelection",
          "group": "commandLayer@2"
        },
        {
          "command": "commandLayer.runFileActions",
          "when": "editorTextFocus",
          "group": "commandLayer@3"
        },
        {
          "command": "commandLayer.runGlobalActions",
          "when": "editorTextFocus",
          "group": "commandLayer@4"
        }
      ],
      "explorer/context": [
        {
          "command": "commandLayer.runAllActions",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        },
        {
          "command": "commandLayer.runFileActions",
          "when": "resourceScheme == file",
          "group": "commandLayer@1"
        }
      ],
      "editor/title": [
        {
          "command": "commandLayer.runEditorTitleAction",
          "when": "commandLayer.hasEditorTitleAction",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "commandLayer.runFileActions",
          "group": "commandLayer"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "commandLayer.runFileActions",
          "group": "commandLayer"
        }
      ],
      "terminal/context": [
        {
          "command": "commandLayer.runGlobalActions",
          "group": "commandLayer"
        }
      ],
      "view/title": [
        {
          "command": "commandLayer.refreshViews",
          "when": "view == commandLayer.explorerView",
          "group": "navigation"
        },
        {
          "command": "commandLayer.refreshViews",
          "when": "view == commandLayer.activityBarView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "commandLayer.copyCommandId",
          "when": "viewItem == commandLayerAction",
          "group": "commandLayer@1"
        },
        {
          "command": "commandLayer.copyActionStub",
          "when": "viewItem == commandLayerAction",
          "group": "commandLayer@2"
        }
      ]
    },
    "configuration": {
      "title": "Command Layer",
      "properties": {
        "commandLayer.textActions": {
          "type": "array",
          "default": [],
          "description": "Offered when a pattern matches in document text. Each entry is a regex plus actions.",
          "items": {
            "type": "object",
            "required": [
              "match",
              "actions"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "Regex source. Capture groups become $1, $2, ... in args; $0 is the whole match."
              },
              "flags": {
                "type": "string",
                "default": "g",
                "description": "Regex flags."
              },
              "when": {
                "type": "object",
                "description": "Optional conditions, all of which must pass.",
                "properties": {
                  "language": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "include": {
                    "type": [
                      "string",
                      "array"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "exclude": {
                    "type": [
                      "string",
                      "array"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object"
                  },
                  "config": {
                    "type": "object"
                  }
                }
              },
              "show": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "link",
                    "codeLens",
                    "codeAction",
                    "hover",
                    "decoration"
                  ]
                },
                "description": "Which surfaces this entry's matches appear on, overriding commandLayer.defaults.surfaces. [] means it appears nowhere."
              },
              "decoration": {
                "type": "object",
                "description": "Inline style when shown on the \"decoration\" surface. Any VS Code DecorationRenderOptions field."
              },
              "actions": {
                "type": "array",
                "description": "One action runs directly; several show a picker. A bare command id string is shorthand for { \"command\": \"...\" }.",
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string",
                          "description": "Label shown in pickers, CodeLens, hovers and menus."
                        },
                        "command": {
                          "type": "string",
                          "description": "Any VS Code command id."
                        },
                        "args": {
                          "type": "array",
                          "description": "Arguments, in order. A plain string is a template with $N (capture groups) and ${varName} substitution. Typed forms: [\"uri\", tpl], [\"object\", tpl] (a structure, preferred, or a string that gets parsed), [\"regex\", tpl], [\"number\", tpl], [\"boolean\", tpl]. Typed args compose inside a structure."
                        },
                        "when": {
                          "type": "object",
                          "description": "Optional conditions, all of which must pass.",
                          "properties": {
                            "language": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "include": {
                              "type": [
                                "string",
                                "array"
                              ],
                              "items": {
                                "type": "string"
                              }
                            },
                            "exclude": {
                              "type": [
                                "string",
                                "array"
                              ],
                              "items": {
                                "type": "string"
                              }
                            },
                            "env": {
                              "type": "object"
                            },
                            "config": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
