              },
              "when": {
                "type": "object",
                "description": "Optional conditions, all of which must pass.",
                "properties": {
                  "language": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "include": {
                    "type": [
                      "string",
                      "array"
                    ],
