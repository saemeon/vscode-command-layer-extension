                  "env": {
                    "type": "object"
                  },
                  "config": {
                    "type": "object"
                  }
                }
              },
              "on": {
                "type": "string",
                "enum": [
                  "workspaceOpen",
                  "fileSave"
                ],
                "description": "Which editor event fires this."
              },
              "confirm": {
                "type": "boolean",
                "default": false,
                "description": "Ask before running. Off by default."
              }
            }
          }
        },
        "commandLayer.explorerView": {
          "type": "array",
          "default": [],
          "description": "Contents of the Command Layer panel in the Explorer sidebar. A list of nodes. A node is a leaf (has \"command\", or is a bare command id), a group (\"title\" plus \"children\" to nest, or \"title\" plus \"from\" to fill it), or a fragment (\"from\" with no \"title\", whose entries splice into the parent). \"filter\" (on the visible label), \"limit\" and \"when\" apply to any node.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Label shown in pickers, CodeLens, hovers and menus."
                  },
                  "command": {
                    "type": "string",
                    "description": "Any VS Code command id."
                  },
                  "args": {
                    "type": "array",
                    "description": "Arguments, in order. A plain string is a template with $N (capture groups) and ${varName} substitution. Typed forms: [\"uri\", tpl], [\"object\", tpl] (a structure, preferred, or a string that gets parsed), [\"regex\", tpl], [\"number\", tpl], [\"boolean\", tpl]. Typed args compose inside a structure."
                  },
                  "when": {
                    "type": "object",
                    "description": "Optional conditions, all of which must pass.",
                    "properties": {
                      "language": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "include": {
                        "type": [
                          "string",
                          "array"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "exclude": {
                        "type": [
                          "string",
                          "array"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "env": {
                        "type": "object"
                      },
                      "config": {
                        "type": "object"
                      }
                    }
                  },
                  "from": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "commandLayer.fetchGlobalActions",
                          "commandLayer.fetchFileActions",
                          "commandLayer.fetchSelectionActions",
                          "commandLayer.fetchTextActions",
                          "commandLayer.fetchTerminalActions",
                          "commandLayer.fetchVSCodeCommands",
                          "commandLayer.fetchVSCodeTasks",
                          "commandLayer.fetchFrequentActions"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "A command id returning a list of actions. The listed ones ship with Command Layer; any command returning an array of actions works."
                  },
                  "children": {
                    "type": "array",
                    "description": "Nested nodes."
                  },
                  "filter": {
                    "type": "string",
                    "description": "Keep only entries whose visible label contains this, case-insensitive."
                  },
                  "limit": {
                    "type": "number",
                    "description": "Maximum entries shown."
                  }
                }
              }
            ]
          }
        },
        "commandLayer.activityBarView": {
          "type": "array",
          "default": [],
          "description": "Contents of the Command Layer panel in its own Activity Bar container. A list of nodes. A node is a leaf (has \"command\", or is a bare command id), a group (\"title\" plus \"children\" to nest, or \"title\" plus \"from\" to fill it), or a fragment (\"from\" with no \"title\", whose entries splice into the parent). \"filter\" (on the visible label), \"limit\" and \"when\" apply to any node.",
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "description": "Label shown in pickers, CodeLens, hovers and menus."
                  },
                  "command": {
                    "type": "string",
                    "description": "Any VS Code command id."
                  },
                  "args": {
                    "type": "array",
                    "description": "Arguments, in order. A plain string is a template with $N (capture groups) and ${varName} substitution. Typed forms: [\"uri\", tpl], [\"object\", tpl] (a structure, preferred, or a string that gets parsed), [\"regex\", tpl], [\"number\", tpl], [\"boolean\", tpl]. Typed args compose inside a structure."
                  },
                  "when": {
                    "type": "object",
                    "description": "Optional conditions, all of which must pass.",
                    "properties": {
                      "language": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "include": {
                        "type": [
                          "string",
                          "array"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "exclude": {
                        "type": [
                          "string",
                          "array"
                        ],
                        "items": {
                          "type": "string"
                        }
                      },
                      "env": {
                        "type": "object"
                      },
                      "config": {
                        "type": "object"
                      }
                    }
                  },
                  "from": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "commandLayer.fetchGlobalActions",
                          "commandLayer.fetchFileActions",
                          "commandLayer.fetchSelectionActions",
                          "commandLayer.fetchTextActions",
                          "commandLayer.fetchTerminalActions",
                          "commandLayer.fetchVSCodeCommands",
                          "commandLayer.fetchVSCodeTasks",
                          "commandLayer.fetchFrequentActions"
                        ]
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "A command id returning a list of actions. The listed ones ship with Command Layer; any command returning an array of actions works."
                  },
                  "children": {
                    "type": "array",
                    "description": "Nested nodes."
                  },
                  "filter": {
                    "type": "string",
                    "description": "Keep only entries whose visible label contains this, case-insensitive."
                  },
                  "limit": {
                    "type": "number",
                    "description": "Maximum entries shown."
                  }
                }
              }
            ]
          }
        },
        "commandLayer.defaults.surfaces": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "link",
              "codeLens",
              "codeAction",
              "hover",
              "decoration"
            ]
          },
          "default": [
            "link",
            "codeLens",
            "codeAction",
            "hover"
          ],
          "description": "Which surfaces a textActions entry appears on when it has no \"show\". \"decoration\" is omitted by default because highlighting every match is intrusive."
        },
        "commandLayer.defaults.decorationStyle": {
          "type": "object",
          "default": {
            "textDecoration": "underline dotted"
          },
          "description": "Inline style for decorated matches. Any VS Code DecorationRenderOptions field."
        },
        "commandLayer.utils.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Load the optional utility commands (commandLayer.util.*). Conveniences, not part of the core extension. Requires a reload."
        },
        "commandLayer.editorTitleAction": {
          "type": "object",
          "default": {},
          "description": "The action behind the button in the editor tab bar. Empty by default, so no button appears. Set a \"command\" — often one of the pickers, e.g. commandLayer.runAllActions — plus optional \"args\" and \"tooltip\".",
          "properties": {
            "command": {
              "type": "string",
              "description": "Any VS Code command id."
            },
            "args": {
              "type": "array"
            },
            "tooltip": {
              "type": "string"
            },
            "when": {
              "type": "object"
            }
          }
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "commandLayer.explorerView",
          "name": "Command Layer",
          "when": "commandLayer.hasExplorerView"
        }
      ],
      "commandLayerContainer": [
        {
          "id": "commandLayer.activityBarView",
          "name": "Commands",
          "when": "commandLayer.hasActivityBarView"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "commandLayerContainer",
          "title": "Command Layer",
          "icon": "$(layers)"
        }
      ]
    }
  }
